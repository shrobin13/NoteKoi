// ============================================================================
// College Resource & Academic Collaboration Platform — v6.0
// Prisma schema — PostgreSQL (Neon)
//
// DBA / senior-engineer notes are inlined as comments next to the decisions
// that need explaining. Read the "IMPORTANT" blocks before running a migration.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// Base account roles (§0.1, §0.2). "CR/Co-CR" and "Guest" are NOT base roles:
// - Guest is unauthenticated, so it has no User row at all.
// - CR/Co-CR is an elevation layered on top of a STUDENT account, tracked in
//   CrCoCrAssignment (§1.4), not a separate value here.
enum Role {
  PLATFORM_ADMIN
  SUB_ADMIN
  STUDENT
  TEACHER
}

// §5.8 — Teacher accounts cannot upload until Sub Admin approves them.
enum TeacherVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
}

// §0.2 — CR and Co-CR hold identical permissions; the distinction is
// organisational only.
enum CrCoCrType {
  CR
  CO_CR
}

// §2.3
enum ResourceType {
  CLASS_NOTES
  LECTURE_NOTES
  SYLLABUS
  VIDEO
  PYQ
  BOOK_PDF
}

// §0.3 — visibility governs *viewing*, not moderation authority.
enum Visibility {
  COLLEGE
  PLATFORM
}

// §5.1 — the ONLY seven real workflow states. "In Review (Deletion Flagged)"
// and "Deletion Denied" are display labels / logged outcomes, not states —
// they are modeled via `deletionFlag` and the DeletionRequest log below,
// never as extra enum values.
enum ResourceState {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  DELETION_REQUESTED
  DELETED
}

// §5.4 — how a resource reached PLATFORM visibility.
enum PromotionPath {
  PATH_A // Student-originated, CR/Co-CR recommendation required
  PATH_B // Teacher-originated, Sub Admin promotes directly
}

enum PromotionRecommendationStatus {
  PENDING
  APPROVED
  DENIED
  INVALIDATED // §5.4 invalidation rule: report / structural edit / deletion request
}

enum PromotionEventAction {
  PROMOTED
  REVOKED // Sub Admin revoking PLATFORM visibility back to COLLEGE
}

// §5.5
enum ReportReason {
  INCORRECT
  SPAM
  PLAGIARISED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// §3.7, §3.9 — a durable log of deletion requests/decisions. "Deletion
// Denied" (§3.9) is the DENIED status here, surfaced on the resource without
// ever being a ResourceState.
enum DeletionRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// §3.8 — every notification event the spec defines, including the Path A /
// Path B split for promotion notifications.
enum NotificationType {
  RESOURCE_APPROVED
  RESOURCE_REJECTED
  PROMOTION_RECOMMENDATION_APPROVED // Path A only
  PROMOTION_RECOMMENDATION_DENIED // Path A only
  DELETION_APPROVED
  DELETION_DENIED
  PROMOTED_RESOURCE_LATER_REJECTED // Path A: uploader + CR/Co-CR + Sub Admin
  // Path B: Sub Admin only (§3.8, §0.2 Teacher)
}

// §5.9, §5.4a, §1.4/§1.5 — Platform Admin's three flavors of exceptional,
// always-logged, never-routine authority.
enum OverrideType {
  RESOURCE_CRUD // §5.9
  PROMOTION_DECISION // §5.4a
  ROLE_APPOINTMENT // §0.2 / §1.4 / §1.5 emergency appointment
}

// ----------------------------------------------------------------------------
// Org structure: College / Department / Session / Course
// ----------------------------------------------------------------------------

// §0.1, §7.1 — exactly one College row per college; Platform Admin manages
// the set of colleges.
model College {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  subAdminAssignments SubAdminAssignment[]
  crCoCrAssignments   CrCoCrAssignment[]
  collegeDepartments  CollegeDepartment[] // §8 "Irrelevant departments hidden" — adoption
  resources           Resource[]

  @@map("colleges")
}

// §2.1, §7.1 — Department is platform-level (not per-college). Colleges
// "adopt" departments via CollegeDepartment.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  courses            Course[]
  collegeDepartments CollegeDepartment[]
  teacherAssignments TeacherDepartment[]
  crCoCrAssignments  CrCoCrAssignment[]

  students  User[]     @relation("StudentDepartment")
  resources Resource[] @relation("ResourceDepartment")

  @@map("departments")
}

// §2.1 — "Students see only departments their college has adopted."
model CollegeDepartment {
  id           String   @id @default(cuid())
  collegeId    String
  departmentId String
  adoptedAt    DateTime @default(now())

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([collegeId, departmentId])
  @@map("college_departments")
}

// §2.1, §7.4 — Session is platform-level, carries a department_id FK, and
// different departments may run different academic calendars.
model Session {
  id           String   @id @default(cuid())
  departmentId String
  label        String // e.g. "2022-23"
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students          User[]             @relation("StudentSession")
  crCoCrAssignments CrCoCrAssignment[]
  resources         Resource[]         @relation("ResourceSession") // PYQ session/year (§3.3)

  @@unique([departmentId, label])
  @@map("sessions")
}

// §2.1, §7.4 — Course is platform-level; identical course listing across
// every college. Renaming never breaks historical resource references
// (course_id is stable — §7.4 course mutability rule).
model Course {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  resources  Resource[]

  @@map("courses")
}

// ----------------------------------------------------------------------------
// Users & role assignments
// ----------------------------------------------------------------------------

// §0.2 — one row per account. Role-specific fields are nullable and only
// meaningful for the relevant Role.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student / Teacher / Sub Admin belong to exactly one college (§0.2).
  // Platform Admin has no college (collegeId null).
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id])

  // --- Student-only fields (§1.2) ---
  regNo        String? // unique within college only — see @@unique below
  departmentId String? // student's single department
  sessionId    String? // student's single session
  department   Department? @relation("StudentDepartment", fields: [departmentId], references: [id])
  session      Session?    @relation("StudentSession", fields: [sessionId], references: [id])
  isVerified   Boolean     @default(false) // email / student-ID verification (§1.2)

  // --- Teacher-only fields (§1.3, §5.8) ---
  teacherVerificationStatus TeacherVerificationStatus?
  teacherDepartments        TeacherDepartment[] // one or more departments taught

  // --- relations as actor in various workflows ---
  uploadedResources  Resource[] @relation("UploaderResources")
  moderatedResources Resource[] @relation("ModeratedResources")

  crCoCrAssignments      CrCoCrAssignment[] @relation("CrCoCrUser")
  crCoCrAppointmentsMade CrCoCrAssignment[] @relation("CrCoCrAppointedBy")
  crCoCrRevocationsMade  CrCoCrAssignment[] @relation("CrCoCrRevokedBy")

  subAdminAssignments      SubAdminAssignment[] @relation("SubAdminUser")
  subAdminAppointmentsMade SubAdminAssignment[] @relation("SubAdminAppointedBy")
  subAdminRevocationsMade  SubAdminAssignment[] @relation("SubAdminRevokedBy")

  promotionRecommendationsMade PromotionRecommendation[] @relation("RecommendedPromotions")
  promotionDecisionsMade       PromotionRecommendation[] @relation("DecidedPromotions")
  promotionEvents              PromotionEvent[]          @relation("PromotionActor")

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsResolved Report[] @relation("ReportsResolved")

  deletionRequestsMade  DeletionRequest[] @relation("DeletionRequestedBy")
  deletionDecisionsMade DeletionRequest[] @relation("DeletionDecidedBy")

  notifications     Notification[]
  adminOverrideLogs AdminOverrideLog[]

  // §1.2 — "reg_no validated unique within the selected college only — two
  // colleges may reuse the same reg_no."
  @@unique([collegeId, regNo])
  @@map("users")
}

// §1.3 — Teacher "may be assigned to teach one or more departments."
model TeacherDepartment {
  id           String   @id @default(cuid())
  teacherId    String
  departmentId String
  assignedAt   DateTime @default(now())

  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, departmentId])
  @@map("teacher_departments")
}

// §1.5, §7.1 — "exactly one Sub Admin per college," appointed/removed by
// Platform Admin. Modeled as a history table (not just a flag on User) so
// that revocation + queue-transfer-on-replacement (§1.5, §8) can be audited.
//
// NOTE: enforcing "only one ACTIVE Sub Admin per college" is a partial-unique
// constraint (`isActive = true`), which core Prisma cannot express directly.
// Enforce it at the application layer, or add a DB-level partial unique index
// via a raw migration, e.g.:
//   CREATE UNIQUE INDEX one_active_sub_admin_per_college
//   ON sub_admin_assignments (college_id) WHERE is_active;
model SubAdminAssignment {
  id            String    @id @default(cuid())
  userId        String
  collegeId     String
  appointedById String // Platform Admin
  appointedAt   DateTime  @default(now())
  revokedById   String? // Platform Admin
  revokedAt     DateTime?
  isActive      Boolean   @default(true)

  user        User    @relation("SubAdminUser", fields: [userId], references: [id])
  college     College @relation(fields: [collegeId], references: [id])
  appointedBy User    @relation("SubAdminAppointedBy", fields: [appointedById], references: [id])
  revokedBy   User?   @relation("SubAdminRevokedBy", fields: [revokedById], references: [id])

  @@index([collegeId, isActive])
  @@map("sub_admin_assignments")
}

// §1.4 — "one CR and optionally one Co-CR per (Department + Session),
// appointed by the Sub Admin." History table for the same audit reasons as
// SubAdminAssignment, plus the emergency-appointment path from §1.4/§0.2.
//
// NOTE: "at most one active CR and one active Co-CR per (college, department,
// session, type)" is likewise a partial-unique constraint — enforce via
// application logic or a raw partial unique index, same caveat as above.
model CrCoCrAssignment {
  id           String     @id @default(cuid())
  userId       String // the Student holding the elevation
  collegeId    String
  departmentId String
  sessionId    String
  type         CrCoCrType

  appointedById          String // normally Sub Admin
  isEmergencyAppointment Boolean  @default(false) // §1.4 — Platform Admin exception
  appointedAt            DateTime @default(now())

  revokedById String?
  revokedAt   DateTime?
  isActive    Boolean   @default(true)

  user        User       @relation("CrCoCrUser", fields: [userId], references: [id])
  college     College    @relation(fields: [collegeId], references: [id])
  department  Department @relation(fields: [departmentId], references: [id])
  session     Session    @relation(fields: [sessionId], references: [id])
  appointedBy User       @relation("CrCoCrAppointedBy", fields: [appointedById], references: [id])
  revokedBy   User?      @relation("CrCoCrRevokedBy", fields: [revokedById], references: [id])

  @@index([departmentId, sessionId, isActive])
  @@map("cr_co_cr_assignments")
}

// ----------------------------------------------------------------------------
// Resources, versioning, and moderation
// ----------------------------------------------------------------------------

// §3.1–§3.9, §5.1, §8 — one row per *record* (§5.6 "moderation acts on
// records, not files"). A new version (§3.5) is a NEW Resource row linked
// back to the same version chain via rootResourceId, NOT a new field on the
// same row. Lightweight metadata edits (§3.6) mutate this row in place with
// no state change; structural edits (§3.6) mutate courseId/departmentId in
// place AND reset state to PENDING — they do NOT create a new version.
model Resource {
  id String @id @default(cuid())

  // --- version chain (§3.5) ---
  rootResourceId String? // null on v1; points at v1's id for v2, v3, ...
  versionNumber  Int        @default(1)
  rootResource   Resource?  @relation("ResourceVersions", fields: [rootResourceId], references: [id])
  versions       Resource[] @relation("ResourceVersions")

  // --- ownership (§3.5 "based on resource ownership, not the uploader's
  // current role") ---
  uploaderId           String
  uploaderRoleSnapshot Role // role at time of upload, for display (§4.1)
  uploader             User   @relation("UploaderResources", fields: [uploaderId], references: [id])

  // --- classification / placement ---
  resourceType ResourceType
  title        String
  description  String?
  tags         String[]

  courseId     String
  departmentId String // denormalized from course.departmentId; kept in
  // sync at the application layer for indexing (§2.1)
  sessionId    String? // required for PYQ (§3.3); optional otherwise

  course     Course     @relation(fields: [courseId], references: [id])
  department Department @relation("ResourceDepartment", fields: [departmentId], references: [id])
  session    Session?   @relation("ResourceSession", fields: [sessionId], references: [id])

  // --- visibility & ownership scope (§0.3, §3.1, §3.2, §3.3) ---
  visibility Visibility
  collegeId  String? // null only for a PLATFORM resource uploaded
  // directly by Platform Admin, who belongs to no college
  college    College?   @relation(fields: [collegeId], references: [id])

  // --- file / link storage ---
  contentHash String? // for object-storage dedup (§3.1, §8 cross-college hash match)
  fileUrl     String?
  youtubeUrl  String? // §3.3 — YouTube link, no file storage consumed

  // --- state machine (§5.1) ---
  state ResourceState @default(PENDING)

  // §3.7 — "In Review (Deletion Flagged)" is this flag on an IN_REVIEW row,
  // never a separate state.
  deletionFlag        Boolean   @default(false)
  deletionRequestedAt DateTime?

  moderatorId         String?
  moderator           User?     @relation("ModeratedResources", fields: [moderatorId], references: [id])
  moderatorDecisionAt DateTime?
  moderatorReason     String? // shown in My Uploads / notifications (§3.8, §3.9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotionRecommendations PromotionRecommendation[]
  promotionEvents          PromotionEvent[]
  reports                  Report[]
  deletionRequests         DeletionRequest[]
  notifications            Notification[]

  // §3.1 duplicate-hash warning is scoped to (college, course, hash)
  @@index([collegeId, courseId, contentHash])
  @@index([rootResourceId])
  @@index([state])
  @@map("resources")
}

// §5.4 Path A, §7.3 — CR/Co-CR recommends; Sub Admin approves/denies.
// Multiple rows may exist per resource over its lifetime (each invalidated
// recommendation is superseded by a fresh one — §5.4 invalidation rule).
model PromotionRecommendation {
  id         String @id @default(cuid())
  resourceId String

  recommendedById String
  recommendedAt   DateTime @default(now())

  status PromotionRecommendationStatus @default(PENDING)

  decidedById String?
  decidedAt   DateTime?

  invalidatedAt      DateTime?
  invalidationReason String? // e.g. "report filed", "structural edit", "deletion requested" (§5.4)

  resource      Resource @relation(fields: [resourceId], references: [id])
  recommendedBy User     @relation("RecommendedPromotions", fields: [recommendedById], references: [id])
  decidedBy     User?    @relation("DecidedPromotions", fields: [decidedById], references: [id])

  promotionEvent PromotionEvent?

  // NOTE: "only one PENDING recommendation per resource at a time" is again
  // a partial-unique constraint — enforce at the application layer or via a
  // raw partial unique index on (resource_id) WHERE status = 'PENDING'.
  @@index([resourceId, status])
  @@map("promotion_recommendations")
}

// §5.4, §5.4a, §7.5 — a durable log of every visibility change and *why* it
// happened, covering both Path A and Path B, plus revocations (Sub Admin)
// and exceptional Platform Admin action (§5.4a). Backs the "promotion counts
// per college" analytic (§7.5).
model PromotionEvent {
  id         String @id @default(cuid())
  resourceId String

  path   PromotionPath
  action PromotionEventAction

  actorId String // Sub Admin (routine) or Platform Admin (exceptional, §5.4a)
  actor   User   @relation("PromotionActor", fields: [actorId], references: [id])

  isExceptionalOverride Boolean @default(false) // true only for §5.4a Platform Admin use

  recommendationId String?                  @unique // set for Path A only
  recommendation   PromotionRecommendation? @relation(fields: [recommendationId], references: [id])

  justificationNote String? // required when isExceptionalOverride = true

  createdAt DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
  @@map("promotion_events")
}

// §5.5 — reporting.
model Report {
  id         String @id @default(cuid())
  resourceId String

  reportedById String
  reason       ReportReason
  note         String?

  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  resolvedById String?
  resolvedAt   DateTime?

  resource   Resource @relation(fields: [resourceId], references: [id])
  reportedBy User     @relation("ReportsFiled", fields: [reportedById], references: [id])
  resolvedBy User?    @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([resourceId, status])
  @@map("reports")
}

// §3.7, §3.9 — durable deletion request/decision log. "Deletion Denied"
// (§3.9) is DeletionRequestStatus.DENIED here — never a ResourceState.
model DeletionRequest {
  id         String @id @default(cuid())
  resourceId String

  requestedById String
  requestedAt   DateTime @default(now())

  status DeletionRequestStatus @default(PENDING)

  decidedById    String?
  decidedAt      DateTime?
  decisionReason String? // shown in My Uploads (§3.9) and notification (§3.8)

  resource    Resource @relation(fields: [resourceId], references: [id])
  requestedBy User     @relation("DeletionRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?    @relation("DeletionDecidedBy", fields: [decidedById], references: [id])

  @@index([resourceId, status])
  @@map("deletion_requests")
}

// §3.8 — in-app notifications (email is additive, not modeled here since My
// Uploads, not notification delivery, is the canonical status source).
// Per the Path B rule (§0.2 Teacher, §3.8), no row is created for a Teacher
// uploader on a direct Sub Admin promotion or its later re-review rejection.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  resourceId String?
  type       NotificationType
  message    String
  reason     String? // moderator / decision reason, when applicable
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id])
  resource Resource? @relation(fields: [resourceId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// §5.9, §5.4a, §1.4/§1.5, §7.5 — one unified audit log for every
// exceptional Platform Admin action, whatever its flavor. §7.5: "Platform
// Admin sees a log of all §5.9 CRUD override actions ... and this same log
// includes any exceptional §5.4a promotion actions and any exceptional
// §1.4/§1.5 role appointments."
model AdminOverrideLog {
  id      String @id @default(cuid())
  actorId String // always Platform Admin
  actor   User   @relation(fields: [actorId], references: [id])

  overrideType OverrideType
  targetType   String // e.g. "Resource", "PromotionRecommendation", "SubAdminAssignment", "CrCoCrAssignment"
  targetId     String
  action       String // e.g. "DELETE", "APPROVE_PROMOTION", "APPOINT_INTERIM_SUB_ADMIN"

  justificationNote String // required — §5.9, §5.4a, §1.4/§1.5 all require this

  createdAt DateTime @default(now())

  @@index([overrideType, createdAt])
  @@map("admin_override_logs")
}
